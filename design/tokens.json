{
  "$note": "Mauna design tokens v0.2. Source of truth for the SwiftUI DesignSystem module. Rules behind these values live in design/DESIGN.md. Colours not listed here come from macOS semantic colours.",
  "color": {
    "accent": {
      "fill":    { "light": "#4C47C4", "dark": "#6762E8", "use": "Active glyph tile, primary button, switch on. White content on top." },
      "text":    { "light": "#4540B8", "dark": "#A9A5FF", "use": "'now' label, active badge, links on backgrounds." },
      "tint":    { "light": "rgba(76,71,196,0.09)", "dark": "rgba(140,136,255,0.15)", "use": "Active rule row background." },
      "pressed": { "light": "#3F3AA8", "dark": "#5A55D6" }
    },
    "semantic": {
      "warning": { "value": "systemOrange", "use": "Permission missing, YouTube Music setup incomplete." },
      "error":   { "value": "systemRed",    "use": "Player unreachable, script failed." },
      "never":   "No green for playing, no red for paused, no colour-coded triggers."
    },
    "neutral": {
      "label":          { "swift": "Color.primary" },
      "secondaryLabel": { "swift": "Color.secondary" },
      "tertiaryLabel":  { "swift": ".tertiary" },
      "fill":           { "swift": ".quaternary / Color(nsColor: .quaternaryLabelColor)", "use": "Badge and well fills" },
      "hairline":       { "light": "rgba(0,0,0,0.06)", "dark": "rgba(255,255,255,0.07)", "use": "0.5pt separators inside groups only" }
    }
  },
  "elevation": {
    "$rule": "Ring + soft shadow. Never a solid 1pt border. System surfaces (MenuBarExtra window, Settings) use the system material and shadow untouched.",
    "e1": { "ring": "0.5pt black 7% / white 8%", "shadow": "y1 blur2 black 4%", "use": "Rows, chips, controls" },
    "e2": { "ring": "0.5pt black 7% / white 8%", "shadow": "y6 blur16 spread-4 #141432 7%", "use": "Cards, settings groups" },
    "e3": { "ring": "0.5pt black 10% / white 14%", "shadow": "y24 blur60 spread-12 #14143C 28%", "use": "Own sheets and windows (onboarding, YouTube Music setup)" },
    "edgeHighlight": "inset top 0.5pt white 90% (light) / 12% (dark) on translucent surfaces"
  },
  "typography": {
    "family": "SF Pro (system). Never bundle a custom font. Never add .tracking() to system text: SF applies size-specific tracking itself.",
    "styles": {
      "title":       { "size": 22, "weight": "bold",     "swift": ".title",                     "use": "Onboarding step title" },
      "title3":      { "size": 15, "weight": "semibold", "swift": ".title3.weight(.semibold)",  "use": "Settings section titles" },
      "headline":    { "size": 13, "weight": "semibold", "swift": ".headline",                  "use": "Popover status line, rule name" },
      "body":        { "size": 13, "weight": "regular",  "swift": ".body",                      "use": "Default text" },
      "callout":     { "size": 12, "weight": "regular",  "swift": ".callout",                   "use": "Helper text, permission reasons" },
      "subheadline": { "size": 11, "weight": "regular",  "swift": ".subheadline",               "use": "Status sub-line, section labels" },
      "caption":     { "size": 10, "weight": "semibold", "swift": ".caption.weight(.semibold)", "use": "Badges" }
    },
    "numerals": ".monospacedDigit() for countdowns, volume and slider values; .contentTransition(.numericText()) when they change."
  },
  "spacing": { "xxs": 2, "xs": 4, "s": 8, "m": 12, "l": 16, "xl": 20, "xxl": 24, "xxxl": 32 },
  "radius": { "badge": "capsule", "row": 9, "control": 8, "glyphTile": 10, "card": 16, "popover": "system", "appIcon": "system" },
  "size": {
    "popoverWidth": 320, "settingsWindowWidth": 560, "onboardingWindow": [520, 460],
    "menuBarGlyph": 18, "statusGlyphTile": 34, "rowAppIcon": 20, "rowHeight": 34
  },
  "glyph": {
    "$rule": "Custom SF Symbol 'mauna.wave'. The glyph says what you hear; the text says why.",
    "barX": [1.5, 5, 8.5, 12, 15.5], "barWidth": 2, "canvas": 18,
    "states": {
      "playing": [6, 12, 16, 10, 5],
      "ducked":  [3, 5, 7, 4, 3],
      "paused":  [2, 2, 2, 2, 2],
      "off":     { "bars": [6, 12, 16, 10, 5], "opacity": 0.35 }
    },
    "brandMark": [6, 12, 8, 3, 2]
  },
  "motion": {
    "easing": {
      "easeOut":   { "bezier": [0.23, 1, 0.32, 1],    "swift": ".timingCurve(0.23, 1, 0.32, 1, duration:)", "use": "Enter, press, popover" },
      "easeInOut": { "bezier": [0.77, 0, 0.175, 1],   "swift": ".timingCurve(0.77, 0, 0.175, 1, duration:)", "use": "On-screen movement" },
      "never": "easeIn, scale from 0, looping or idle animation"
    },
    "spring": {
      "default": { "response": 0.3,  "dampingFraction": 1.0, "swift": ".spring(response: 0.3, dampingFraction: 1)", "use": "Glyph morph, highlights" },
      "flick":   { "response": 0.35, "dampingFraction": 0.8, "use": "Only after a gesture with momentum" }
    },
    "duration": { "press": 0.16, "textCrossfade": 0.2, "rowHighlight": 0.2, "popoverIn": 0.16, "popoverOut": 0.11, "onboardingStep": 0.3, "staggerStep": [0.04, 0.08] },
    "press": { "scale": 0.97, "trigger": "on press, not release" },
    "crossfadeBlur": 2,
    "byMoment": {
      "quietShortcut":  "instant — no UI animation; the audio fade is the feedback",
      "popoverOpen":    "system default",
      "ruleStateChange":"glyph spring + text blur crossfade + row tint",
      "menuBarIdle":    "never animates"
    },
    "reducedMotion": "opacity crossfades only; no scale, slide or spring"
  },
  "audio": {
    "fadeOut": 1.2, "fadeIn": 1.8, "fadeRange": [0.0, 5.0], "fadeStep": 0.1,
    "curve": "equal-power: out = cos(t·π/2), in = sin(t·π/2); always start from the current volume",
    "debounce": 1.5, "shortcutDoublePressIgnore": 0.3, "shortSoundIgnore": 3.0,
    "normalVolume": 0.70, "duckLevel": 0.20, "autoRestore": "off", "autoRestoreOptions": [60, 300, 900]
  }
}
